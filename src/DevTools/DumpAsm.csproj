<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Override on the command line: -p:GameDir="D:\path\to\game" -->
    <GameDir Condition="'$(GameDir)' == ''">D:\SteamLibrary\steamapps\common\角色屋 桌面伙伴 Demo</GameDir>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>DumpAsm</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <NoWarn>$(NoWarn);NETSDK1138;CS1701;CS1702</NoWarn>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <!-- No apphost: avoids needing the Microsoft.NETCore.App.Host ref package,
         which our offline setup cannot resolve. Run via `dotnet DumpAsm.dll`. -->
    <UseAppHost>false</UseAppHost>
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(GameDir)\BepInEx\core\Mono.Cecil.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
