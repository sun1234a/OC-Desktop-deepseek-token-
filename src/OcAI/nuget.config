<?xml version="1.0" encoding="utf-8"?>
<!--
  Offline restore only. The pre-existing local feed (..\..\localfeed) carries the
  net6.0 targeting packs as 6.0.0 nupkgs; the installed SDK would otherwise ask
  for 6.0.36 and fail with NU1100 because api.nuget.org is unreachable here.
  No remote source is configured on purpose: nothing in this build may depend on
  the network.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="localfeed" value="..\..\localfeed" />
  </packageSources>
</configuration>
